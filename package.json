{
  "name": "itext-social",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode independent",
    "build": "node scripts/build-independent.mjs",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test tests/*.test.js",
    "build:independent": "node scripts/build-independent.mjs",
    "deploy:independent": "npm run check:deployment && npm run build && firebase deploy --only hosting",
    "deploy:firebase": "npm run check:deployment && npm run build && firebase deploy --only hosting",
    "check:deployment": "node scripts/check-deployment.mjs",
    "predev": "node scripts/prepare-video-editor.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@supabase/supabase-js": "^2.118.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "openpgp": "^6.3.2",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "firebase-tools": "^15.34.0",
    "globals": "latest"
  }
}
